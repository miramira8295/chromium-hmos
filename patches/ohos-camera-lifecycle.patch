+#if BUILDFLAG(IS_OHOS)
+void MediaCaptureDevices::SetApplicationForegroundForOhos(bool foreground) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](bool foreground) {
+            // Resolve on IO instead of retaining a manager across shutdown.
+            if (auto* manager = MediaStreamManager::GetInstance()) {
+              manager->video_capture_manager()->SetApplicationForegroundForOhos(
+                  foreground);
+            }
+          },
+          foreground));
+}
+#endif
