+  vcm_->SetApplicationForegroundForOhos(true);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(video_capture_device_factory_->has_active_devices());
+
+  StopClient(client);
+  vcm_->Close(session);
+  base::RunLoop().RunUntilIdle();
+  vcm_->UnregisterListener(listener_.get());
