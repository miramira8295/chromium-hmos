+#if BUILDFLAG(IS_OHOS)
+void VideoCaptureManager::SetApplicationForegroundForOhos(bool foreground) {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M158);
+  if (application_foreground_ == foreground) {
+    return;
+  }
+  application_foreground_ = foreground;
+  LOG(WARNING) << "OHOS camera lifecycle: "
+               << (foreground ? "foreground; restoring devices"
+                              : "background; releasing devices");
+  if (foreground) {
+    ResumeDevices();
+  } else {
+    ReleaseDevices();
+  }
+}
+#endif
