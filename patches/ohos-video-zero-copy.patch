+#if BUILDFLAG(IS_OHOS)
+scoped_refptr<ClientSharedImage>
+GpuChannelSharedImageInterface::CreateSharedImageForOhosVideo(
+    const SharedImageInfo& si_info,
+    scoped_refptr<gfx::NativePixmap> pixmap,
+    gfx::GpuFenceHandle acquire_fence,
+    const GpuDriverBugWorkarounds& workarounds) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(gpu_sequence_checker_);
+  if (!shared_image_stub_ || !pixmap ||
+      !shared_image_stub_->MakeContextCurrent(/*needs_gl=*/true)) {
+    return nullptr;
+  }
+  auto context = shared_image_stub_->shared_context_state();
+  if (context->context_lost() ||
+      context->gr_context_type() != GrContextType::kGL ||
+      !gl::GLFence::IsGpuFenceSupported()) {
+    return nullptr;
+  }
+  const auto mailbox = Mailbox::Generate();
+  auto backing = std::make_unique<OzoneImageBacking>(
+      mailbox, si_info, context, std::move(pixmap), workarounds);
+  backing->SetCleared();
+  if (!acquire_fence.is_null()) {
+    backing->Update(std::make_unique<gfx::GpuFence>(std::move(acquire_fence)));
+  }
+  if (!shared_image_stub_->factory()->RegisterBacking(std::move(backing))) {
+    return nullptr;
+  }
+  return base::WrapRefCounted<ClientSharedImage>(
+      new ClientSharedImage(mailbox, si_info, GenVerifiedSyncToken(), holder_,
+                            GL_TEXTURE_EXTERNAL_OES));
+}
+#endif
