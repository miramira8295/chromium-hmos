+double ChromeZoomLevelPrefs::GetEffectiveDefaultZoomLevel() const {
+#if BUILDFLAG(IS_OHOS)
+  return GetDefaultZoomLevelPref() +
+         blink::ZoomFactorToZoomLevel(g_ohos_system_font_scale);
+#else
+  return GetDefaultZoomLevelPref();
+#endif
+}
+
+#if BUILDFLAG(IS_OHOS)
+// static
+void ChromeZoomLevelPrefs::SetOhosSystemFontScale(double scale) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!(scale > 0)) {
+    return;
+  }
+  scale = std::clamp(scale, kMinOhosFontScale, kMaxOhosFontScale);
+  if (scale == g_ohos_system_font_scale) {
+    return;
+  }
+  g_ohos_system_font_scale = scale;
+  for (ChromeZoomLevelPrefs* prefs : OhosZoomLevelPrefs()) {
+    prefs->ApplyEffectiveDefaultZoomLevel();
+  }
+}
+
+void ChromeZoomLevelPrefs::ApplyEffectiveDefaultZoomLevel() {
+  if (!host_zoom_map_) {
+    // InitHostZoomMap() picks the scale up.
+    return;
+  }
+  // Updates every page without a zoom level of its own, in place.
+  host_zoom_map_->SetDefaultZoomLevel(GetEffectiveDefaultZoomLevel());
+  default_zoom_changed_callbacks_.Notify();
+  if (zoom_event_manager_) {
+    zoom_event_manager_->OnDefaultZoomLevelChanged();
+  }
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
 double ChromeZoomLevelPrefs::GetDefaultZoomFactor() const {
   return blink::ZoomLevelToZoomFactor(GetDefaultZoomLevelPref());
 }
