+#if BUILDFLAG(IS_OHOS)
+void AddOhosPlatformKeySystem(const std::string& key_system,
+                              const media::KeySystemCapability& capability,
+                              bool can_persist_data,
+                              KeySystemInfos* key_systems) {
+  // The licenses are bound to a device certificate every site shares, so,
+  // as Android does for its platform key systems, none in incognito.
+  if (!can_persist_data) {
+    return;
+  }
+  // Software security only: CdmRegistryImpl reports no hardware capability.
+  if (!capability.sw_cdm_capability_or_status.has_value()) {
+    return;
+  }
+  const auto& sw_secure_capability =
+      capability.sw_cdm_capability_or_status.value();
+  key_systems->push_back(std::make_unique<OhosKeySystemInfo>(
+      key_system, GetSupportedCodecs(sw_secure_capability),
+      sw_secure_capability.encryption_schemes));
+}
+#endif  // BUILDFLAG(IS_OHOS)
+
