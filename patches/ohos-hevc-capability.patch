Enable HEVC, AC-3 and DTS for the AVCodecKit decoders on OHOS.

Keep support optional: Chromium obtains the supported HEVC profiles from the
GPU decoder capability query rather than advertising HEVC on every device.
No software HEVC decoder or DRM support is added.

AC-3 and DTS, which Chromium cannot decode itself, go to the system's
AVCodecKit audio decoders in the GPU process (media/gpu/ohos): the
"audio_decoder" mojo media service is enabled, and the renderer answers
canPlayType and MSE from the configs the GPU process reports, as Windows
and Mac do for AC-3. E-AC-3, DTS:X and DTS Express are never offered: the
system has no decoder for them.

Generated against runner source snapshot 37748799880, pinned Chromium
743f26418a267dd97c3c1c71d786038ae68cfc8f (154.0.8037.51).

diff --git a/media/media_options.gni b/media/media_options.gni
--- a/media/media_options.gni
+++ b/media/media_options.gni
@@ -82,9 +82,13 @@
 
   # Enables AC3/EAC3 audio handling in chromium. This includes demuxing,
   # on-device decoding and bitstream passthrough on Android.
+  # On OHOS the system decodes AC-3 in the GPU process (media/gpu/ohos); the
+  # renderer offers it only when that decoder exists, and never E-AC-3, which
+  # the system lacks.
   enable_platform_ac3_eac3_audio =
       proprietary_codecs &&
-      (is_cast_media_device || (is_ios && target_platform == "tvos"))
+      (is_cast_media_device || (is_ios && target_platform == "tvos") ||
+       is_ohos)
 
   # Enables AC4 audio handling in chromium. This includes demuxing,
   # on-device decoding as supported by device.
@@ -94,7 +98,8 @@
 
   # Enables DTS/DTSX audio handling in chromium. This includes demuxing,
   # on-device decoding and bitstream passthrough on Android and Windows.
-  enable_platform_dts_audio = false
+  # On OHOS the system decodes DTS in the GPU process, as AC-3 above.
+  enable_platform_dts_audio = proprietary_codecs && is_ohos
 
   # Enables IAMF audio handling in chromium. This includes demuxing and
   # on-device decoding.
@@ -135,7 +140,8 @@
   # Windows, Mac, and Android.
   enable_hevc_parser_and_hw_decoder =
       proprietary_codecs &&
-      (use_fuzzing_engine || is_win || is_apple || is_android || is_linux)
+      (use_fuzzing_engine || is_win || is_apple || is_android || is_linux ||
+       is_ohos)
 
   # Determines if a GpuChannel is needed between media capture utility process
   # and gpu process for a given platform.
@@ -179,7 +185,7 @@
 declare_args() {
   platform_has_optional_hevc_decode_support =
       enable_platform_hevc &&
-      (is_win || is_chromeos || is_linux || is_apple || is_android)
+      (is_win || is_chromeos || is_linux || is_apple || is_android || is_ohos)
   platform_has_optional_hevc_encode_support =
       enable_platform_hevc && (is_win || is_apple || is_android)
 }
@@ -338,8 +344,13 @@
   _default_mojo_media_host = "gpu"
 } else if (is_ohos) {
   # Hardware decoding goes through AVCodecKit in the GPU process
-  # (media/gpu/ohos). Audio stays on the renderer's software decoders.
-  _default_mojo_media_services = [ "video_decoder" ]
+  # (media/gpu/ohos). Audio stays on the renderer's software decoders except
+  # for what Chromium cannot decode itself -- AC-3 and DTS -- which the
+  # system's AVCodecKit audio decoders handle there too.
+  _default_mojo_media_services = [
+    "audio_decoder",
+    "video_decoder",
+  ]
   _default_mojo_media_host = "gpu"
 }
 
diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -319,13 +319,15 @@
 bool IsDecoderDolbyAc3Eac3Supported(const AudioType& type) {
 #if BUILDFLAG(ENABLE_PLATFORM_AC3_EAC3_AUDIO)
 #if BUILDFLAG(ENABLE_MOJO_AUDIO_DECODER) && \
-    (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC))
+    (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_OHOS))
+  // On OHOS, the system decoders the GPU process found: AC-3 where it has
+  // one, never E-AC-3, which it lacks.
   return GetSupplementalDecoderAudioTypeCache()->IsProfileSupported(type);
 #else
   // Keep 'true' for other platforms as old code snippet.
   return true;
 #endif  // BUILDFLAG(ENABLE_MOJO_AUDIO_DECODER) && (BUILDFLAG(IS_WIN) ||
-        // BUILDFLAG(IS_MAC))
+        // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_OHOS))
 #else
   return false;
 #endif  // BUILDFLAG(ENABLE_PLATFORM_AC3_EAC3_AUDIO)
@@ -503,7 +505,14 @@
     case AudioCodec::kDTS:
     case AudioCodec::kDTSXP2:
     case AudioCodec::kDTSE:
+#if BUILDFLAG(IS_OHOS) && BUILDFLAG(ENABLE_PLATFORM_DTS_AUDIO) && \
+    BUILDFLAG(ENABLE_MOJO_AUDIO_DECODER)
+      // Only what the system decoders in the GPU process report: DTS where
+      // there is one, and not the DTS:X or DTS Express variants.
+      return GetSupplementalDecoderAudioTypeCache()->IsProfileSupported(type);
+#else
       return BUILDFLAG(ENABLE_PLATFORM_DTS_AUDIO);
+#endif
     case AudioCodec::kAC3:
     case AudioCodec::kEAC3:
       return IsDecoderDolbyAc3Eac3Supported(type);
