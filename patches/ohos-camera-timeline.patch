Keep OHOS camera timestamps continuous across native device restarts.

Anchor camera frame timestamps to a monotonic reference in the persistent
VideoCaptureController. Native delegates and utility processes can restart
without resetting the existing track timeline. Preserve reference/capture
metadata and elapsed background time; do not alter desktop/tab capture.

Generated against Chromium 154.0.8037.97. Included in the main adapter patch
for clean builds; this patch upgrades persistent runner trees.

diff --git a/content/browser/renderer_host/media/video_capture_controller.cc b/content/browser/renderer_host/media/video_capture_controller.cc
index be80737..25881dc 100644
--- a/content/browser/renderer_host/media/video_capture_controller.cc
+++ b/content/browser/renderer_host/media/video_capture_controller.cc
@@ -470,6 +470,21 @@ void VideoCaptureController::OnFrameReadyInBuffer(
   TRACE_EVENT0(TRACE_DISABLED_BY_DEFAULT("video_and_image_capture"),
                "VideoCaptureController::OnFrameReadyInBuffer");
 
+#if BUILDFLAG(IS_OHOS)
+  // The OHOS capture delegate's relative timestamp restarts when the app returns
+  // from the background. The controller (and its tracks) outlives that device.
+  // Anchor every camera frame to the same monotonic reference clock, keeping
+  // the background gap and leaving capture/reference metadata untouched.
+  const auto& reference_time = frame.frame_info->metadata.reference_time;
+  if (stream_type_ == blink::mojom::MediaStreamType::DEVICE_VIDEO_CAPTURE &&
+      reference_time && !reference_time->is_null()) {
+    if (first_camera_reference_time_.is_null()) {
+      first_camera_reference_time_ = *reference_time;
+    }
+    frame.frame_info->timestamp = *reference_time - first_camera_reference_time_;
+  }
+#endif
+
   // Make ready buffers, get frame contexts and set their feedback IDs.
   // Transfer ownership of all the frame infos.
   BufferContext* frame_context;
