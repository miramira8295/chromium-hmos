+#if BUILDFLAG(IS_OHOS)
+TEST_F(VideoCaptureControllerTest, OhosCameraTimelineSurvivesDeviceRestart) {
+  media::VideoCaptureParams params;
+  params.requested_format = arbitrary_format_;
+  controller_->AddClient(arbitrary_route_id_, {}, client_a_.get(),
+                         arbitrary_session_id_, params, std::nullopt);
+  EXPECT_CALL(*client_a_, DoBufferCreated(_, _)).Times(21);
+  EXPECT_CALL(*client_a_, DoBufferDestroyed(_, _)).Times(21);
+  EXPECT_CALL(*client_a_, DoBufferReady(_)).Times(42);
+
+  const base::TimeTicks origin = base::TimeTicks() + base::Seconds(100);
+  for (int generation = 0; generation <= 20; ++generation) {
+    if (generation > 0) {
+      // Recreate the device client and pool, retaining the controller/client
+      // just as VideoCaptureManager does across application visibility changes.
+      device_client_.reset();
+      base::RunLoop().RunUntilIdle();
+      mock_launched_device_ = nullptr;
+      controller_->ReleaseDeviceAsync(base::DoNothing());
+      InitializeNewDeviceClientAndBufferPoolInstances();
+      auto device = std::make_unique<MockLaunchedVideoCaptureDevice>();
+      mock_launched_device_ = device.get();
+      controller_->OnDeviceLaunched(std::move(device));
+    }
+    // The first timestamp is zero, the second nonzero. Checking only the first
+    // frame would miss the renderer's special fallback for zero timestamps.
+    for (int frame = 0; frame < 2; ++frame) {
+      const auto device_timestamp = base::Milliseconds(frame * 67);
+      const auto elapsed = base::Seconds(generation * 3) + device_timestamp;
+      SendStubFrameToDeviceClient(arbitrary_format_, arbitrary_color_space_,
+                                 origin + elapsed, device_timestamp);
+      base::RunLoop().RunUntilIdle();
+      ASSERT_TRUE(client_a_->last_timestamp_);
+      EXPECT_EQ(elapsed, *client_a_->last_timestamp_);
+      EXPECT_EQ(origin + elapsed, client_a_->last_reference_time_);
+    }
+  }
+  device_client_.reset();
+  base::RunLoop().RunUntilIdle();
+  controller_->RemoveClient(arbitrary_route_id_, client_a_.get());
+}
