+scoped_refptr<ClientSharedImage>
+GpuChannelSharedImageInterface::CreateSharedImageForOhosVideo(
+    const SharedImageInfo& si_info,
+    scoped_refptr<gfx::NativePixmap> pixmap,
+    gfx::GpuFenceHandle acquire_fence,
+    const GpuDriverBugWorkarounds& workarounds,
+    std::optional<VulkanYCbCrInfo>* graphite_info) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(gpu_sequence_checker_);
+  if (!shared_image_stub_ || !pixmap) {
+    return nullptr;
+  }
+  auto context = shared_image_stub_->shared_context_state();
+  const bool use_vulkan = context->GrContextIsVulkan();
+  const bool use_graphite = context->IsGraphiteDawnVulkan();
+  if (context->context_lost() ||
+      !shared_image_stub_->MakeContextCurrent(/*needs_gl=*/!use_vulkan && !use_graphite)) {
+    return nullptr;
+  }
+  const auto mailbox = Mailbox::Generate();
+  std::unique_ptr<SharedImageBacking> backing;
+#if BUILDFLAG(ENABLE_VULKAN)
+  if (use_vulkan) {
+    backing = ExternalVkImageBacking::CreateForOhosVideo(
+        context, mailbox, si_info, std::move(pixmap));
+  } else
+#endif
+  if (use_graphite) {
+#if BUILDFLAG(SKIA_USE_DAWN)
+    auto native = std::make_unique<OzoneImageBacking>(
+        mailbox, si_info, context, std::move(pixmap), workarounds);
+    auto info = native->GetVkCbCrInfo(context.get());
+    if (!info || !graphite_info)
+      return nullptr;
+    *graphite_info = *info;
+    backing = std::move(native);
+#endif
+  } else if (context->GrContextIsGL() && gl::GLFence::IsGpuFenceSupported()) {
+    backing = std::make_unique<OzoneImageBacking>(
+        mailbox, si_info, context, std::move(pixmap), workarounds);
+  }
+  if (!backing) {
+    return nullptr;
+  }
+  backing->SetCleared();
+  if (!acquire_fence.is_null()) {
+    backing->Update(std::move(acquire_fence));
+  }
+  if (context->context_lost()) {
+    return nullptr;
+  }
+  if (!shared_image_stub_->factory()->RegisterBacking(std::move(backing))) {
+    return nullptr;
+  }
+  return base::WrapRefCounted<ClientSharedImage>(
+      new ClientSharedImage(mailbox, si_info, GenVerifiedSyncToken(), holder_,
+                            (use_vulkan || use_graphite) ? 0 : GL_TEXTURE_EXTERNAL_OES));
+}
