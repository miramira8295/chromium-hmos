+bool ApplyOhosSystemFontWebPreferences(WebPreferences* web_prefs) {
+  const float scale = chrome::ohos::GetAuraShellSystemFontScale();
+  const bool changed = web_prefs->font_scale_factor != scale ||
+                       !web_prefs->text_size_adjust_enabled;
+  web_prefs->font_scale_factor = scale;
+  web_prefs->text_size_adjust_enabled = true;
