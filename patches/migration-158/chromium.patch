--- a/chrome/common/media/cdm_registration.cc
+++ b/chrome/common/media/cdm_registration.cc
@@ -430,6 +430,19 @@ void RegisterCdmInfo(std::vector<content::CdmInfo>* cdms) {
   cdm::AddOtherAndroidCdms(cdms);
 #endif  // BUILDFLAG(IS_ANDROID)
 
+#if BUILDFLAG(IS_OHOS)
+  // WisePlay through HarmonyOS DRM Kit, served by OhosCdm in the GPU
+  // process. Registered without capabilities, as Android's platform key
+  // systems are: CdmRegistryImpl asks DRM Kit the first time a page wants
+  // it. Only software security so far. The CdmType is unused for a platform
+  // CDM but must differ from every other.
+  const media::CdmType kOhosCdmType{0x3d5e6d359b9a41e8ull,
+                                    0xb843dd3c6e72c42cull};
+  cdms->emplace_back("com.wiseplay.drm",
+                     content::CdmInfo::Robustness::kSoftwareSecure,
+                     std::nullopt, kOhosCdmType);
+#endif  // BUILDFLAG(IS_OHOS)
+
   DVLOG(3) << __func__ << " done with " << cdms->size() << " cdms";
 }
 
