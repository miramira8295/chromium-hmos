+  // takes the ability away from all of them. Wide content then overflows and
+  // scrolls sideways, which is the ordinary way to read a wide table and what
+  // the shell asked for.
+  web_prefs->default_minimum_page_scale_factor = is_web_ui ? 1.0f : 0.25f;
