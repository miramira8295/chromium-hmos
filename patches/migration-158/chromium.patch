+constexpr char kHarmonyOsMathFamily[] = "Noto Sans Math";
+
+std::string GetOhosDefaultFontFamily(const char* pref_name) {
+  const std::string_view name(pref_name);
+  if (name == prefs::kWebKitFixedFontFamily) {
+    return kHarmonyOsFixedFamily;
+  }
