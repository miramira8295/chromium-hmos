+  input.has_input = true;
+  Surface* input_surface = CreateSurface(FrameSinkId(0, 2), input);
+  DrawSurfaces({video_surface, input_surface}, kNow);
+  ExpectResult(TakeLastResult(), base::Hertz(120) - base::Microseconds(50));
+
+  video.frame_time = kNow + base::Milliseconds(501);
+  UpdateFrame(video_surface, video);
+  DrawSurfaces({video_surface, input_surface}, video.frame_time);
+  ExpectResult(TakeLastResult(), base::Hertz(30) / 2);
+  EXPECT_EQ(FrameIntervalMatcherType::kOnlyVideo, TakeLastMatcherType());
+}
