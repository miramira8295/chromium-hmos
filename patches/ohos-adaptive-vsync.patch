+// Exercise the real matchers with the OHOS native request range. In particular,
+// 1000/1001 video intervals must not accidentally select an extra cadence.
+TEST_F(FrameIntervalDeciderTest, OhosVideoCadences) {
+  struct TestCase {
+    double video_hz;
+    double request_hz;
+  };
+  constexpr TestCase cases[] = {
+      {24, 72}, {24000.0 / 1001, 72}, {25, 75},
+      {30, 60}, {30000.0 / 1001, 60}, {50, 100},
+      {60, 60}, {60000.0 / 1001, 60}, {120, 120}, {240, 120}};
+  uint32_t sink_id = 1;
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.video_hz);
+    decider_ = std::make_unique<FrameIntervalDecider>();
+    InitializeOhosVideoDecider();
+    FrameIntervalInputs inputs;
+    inputs.frame_time = kNow;
+    inputs.has_only_content_frame_interval_updates = true;
+    inputs.content_interval_info.push_back(
+        {ContentFrameIntervalType::kVideo, base::Hertz(test.video_hz)});
+    Surface* surface = CreateSurface(FrameSinkId(0, sink_id++), inputs);
+    DrawSurfaces({surface}, kNow);
+    Result result = TakeLastResult();
+    ASSERT_TRUE(std::holds_alternative<ResultInterval>(result));
+    EXPECT_NEAR(test.request_hz,
+                1.0 / std::get<ResultInterval>(result).interval.InSecondsF(),
+                0.15);
+    EXPECT_EQ(FrameIntervalMatcherType::kOnlyVideo, TakeLastMatcherType());
+  }
+}
+
+TEST_F(FrameIntervalDeciderTest, OhosVideoDownshiftAndInputBoost) {
+  InitializeOhosVideoDecider();
+  FrameIntervalInputs inputs;
+  inputs.frame_time = kNow;
+  Surface* surface = CreateSurface(FrameSinkId(0, 1), inputs);
+  DrawSurfaces({surface}, kNow);
+  ExpectResult(TakeLastResult(), base::Hertz(120));
+
+  inputs.has_only_content_frame_interval_updates = true;
+  inputs.content_interval_info.push_back(
+      {ContentFrameIntervalType::kVideo, base::Hertz(30)});
+  auto draw_at = [&](int milliseconds) {
+    inputs.frame_time = kNow + base::Milliseconds(milliseconds);
+    UpdateFrame(surface, inputs);
+    DrawSurfaces({surface}, inputs.frame_time);
+  };
+  draw_at(100);
+  EXPECT_FALSE(has_result());
+  draw_at(499);
+  EXPECT_FALSE(has_result());
+  draw_at(501);
+  ExpectResult(TakeLastResult(), base::Hertz(30) / 2);
+  EXPECT_EQ(FrameIntervalMatcherType::kOnlyVideo, TakeLastMatcherType());
+
+  // Input takes precedence over video in the very next aggregation.
+  inputs.has_input = true;
+  draw_at(510);
+  ExpectResult(TakeLastResult(), base::Hertz(120) - base::Microseconds(50));
+  EXPECT_EQ(FrameIntervalMatcherType::kInputBoost, TakeLastMatcherType());
+  inputs.has_input = false;
+  draw_at(1009);
+  EXPECT_FALSE(has_result());
+  draw_at(1011);
+  ExpectResult(TakeLastResult(), base::Hertz(30) / 2);
+
+  // Non-video damage immediately restores the high-rate default too.
+  inputs.has_only_content_frame_interval_updates = false;
+  draw_at(1012);
+  ExpectResult(TakeLastResult(), base::Hertz(120));
+  EXPECT_EQ(FrameIntervalMatcherType::kNone, TakeLastMatcherType());
+}
+
+TEST_F(FrameIntervalDeciderTest, OhosStaleInputDoesNotHoldVideoAtHighRate) {
