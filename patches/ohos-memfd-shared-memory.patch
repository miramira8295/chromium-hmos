+// Isolated children cannot chmod memfds on some HarmonyOS images. Report the
+// first failed operation per process without flooding ordinary file fallback.
+void LogOhosSharedMemoryFailure(const char* operation) {
+  static std::atomic<bool> logged{false};
+  if (!logged.exchange(true, std::memory_order_relaxed)) {
+    PLOG(ERROR) << "OHOS shared memory " << operation << " failed";
+  }
+}
+
+// Writable memfds keep their seal set open until conversion. Once read-only,
+// even reopening the fd through procfs must not restore write access. Existing
+// writable mappings remain usable, as required by ReadOnlySharedMemoryRegion.
+bool FinalizeOhosSharedMemoryRegion(int fd, bool read_only) {
+  const int seals = fcntl(fd, F_GET_SEALS);
+  const int seals_errno = errno;
+  if ((seals < 0 && seals_errno == EINVAL) || seals == F_SEAL_SEAL) {
+    // The compatibility backend uses private unlinked files. Disk files do not
+    // support seals; ordinary tmpfs files start with only F_SEAL_SEAL. Neither
+    // case may silently accept a world-writable file instead of a sealed memfd.
+    struct stat info = {};
+    if (fstat(fd, &info) != 0) {
+      LogOhosSharedMemoryFailure("fallback permissions query");
+      return false;
+    }
+    if (info.st_mode & (S_IWGRP | S_IWOTH)) {
+      errno = EACCES;
+      LogOhosSharedMemoryFailure("fallback permissions validation");
+      return false;
+    }
+    return true;
+  }
+  if (seals < 0) {
+    errno = seals_errno;
+    LogOhosSharedMemoryFailure("seals query");
+    return false;
+  }
+  const int required = F_SEAL_SEAL | (read_only ? F_SEAL_FUTURE_WRITE : 0);
+  if ((seals & required) != required && fcntl(fd, F_ADD_SEALS, required) != 0) {
+    LogOhosSharedMemoryFailure(read_only ? "readonly sealing"
+                                         : "unsafe sealing");
+    return false;
+  }
+  if (read_only) {
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true, std::memory_order_relaxed)) {
+      LOG(WARNING) << "OHOS shared memory readonly sealing active";
+    }
+  }
+  return true;
+}
+#endif
