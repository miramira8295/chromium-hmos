+// A sealed O_RDWR memfd is read-only for every new mapping and write syscall.
+// This is also checked when receiving an untrusted shared-memory handle.
+bool IsOhosSealedReadOnlyMemfd(int fd) {
+  constexpr int required =
+      F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_FUTURE_WRITE | F_SEAL_SEAL;
+  const int seals = fcntl(fd, F_GET_SEALS);
+  return seals >= 0 && (seals & required) == required;
+}
+
+// When procfs reopen is forbidden, the paired descriptor is a dup of the
+// writable memfd until conversion. Accept only the same size-sealed inode,
+// still open for adding write seals; never accept an arbitrary O_RDWR pair.
+bool IsOhosWritableMemfdPair(FDPair handle) {
+  const int seals = fcntl(handle.fd, F_GET_SEALS);
+  constexpr int size_seals = F_SEAL_SHRINK | F_SEAL_GROW;
+  constexpr int final_seals = F_SEAL_SEAL | F_SEAL_WRITE | F_SEAL_FUTURE_WRITE;
+  if (seals < 0 || (seals & size_seals) != size_seals ||
+      (seals & final_seals) != 0) {
+    return false;
+  }
+  struct stat primary = {};
+  struct stat paired = {};
+  return fstat(handle.fd, &primary) == 0 &&
+         fstat(handle.readonly_fd, &paired) == 0 && S_ISREG(primary.st_mode) &&
+         primary.st_dev == paired.st_dev && primary.st_ino == paired.st_ino;
+}
+#endif
