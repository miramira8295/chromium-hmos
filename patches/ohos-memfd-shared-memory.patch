+// Test the actual attack: a readonly receiver reopens its fd with O_RDWR.
+// Permission bits and UID separation must not be needed to prevent writes.
+TEST_F(PlatformSharedMemoryRegionTest, MemfdReadOnlyReopenCannotWrite) {
+  auto region = PlatformSharedMemoryRegion::CreateWritable(kRegionSize);
+  ASSERT_TRUE(region.IsValid());
+  ASSERT_TRUE(IsMemfd(region.GetPlatformHandle().fd));
+  auto writer = MapForTesting(&region);
+  ASSERT_TRUE(writer.IsValid());
+  ASSERT_TRUE(region.ConvertToReadOnly());
+  const int readonly_fd = region.GetPlatformHandle().fd;
+  const int expected =
+      F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_FUTURE_WRITE | F_SEAL_SEAL;
+  EXPECT_EQ(expected, fcntl(readonly_fd, F_GET_SEALS) & expected);
+  auto reader = MapForTesting(&region);
+  ASSERT_TRUE(reader.IsValid());
+  writer.GetMemoryAsSpan<uint8_t>()[0] = 0x5a;
+  EXPECT_EQ(0x5a, reader.GetMemoryAsSpan<const uint8_t>()[0]);
+
+  ScopedFD reopened(
+      HANDLE_EINTR(open(StringPrintf("/proc/self/fd/%d", readonly_fd).c_str(),
+                        O_RDWR | O_CLOEXEC)));
+  if (!reopened.is_valid()) {
+    EXPECT_TRUE(errno == EACCES || errno == EPERM);
+    return;
+  }
+  const uint8_t value = 0xff;
+  EXPECT_EQ(-1, pwrite(reopened.get(), &value, sizeof(value), 0));
+  EXPECT_EQ(EPERM, errno);
+  void* mapping = mmap(nullptr, kRegionSize, PROT_READ | PROT_WRITE, MAP_SHARED,
+                       reopened.get(), 0);
+  EXPECT_EQ(MAP_FAILED, mapping);
+  if (mapping != MAP_FAILED) {
+    munmap(mapping, kRegionSize);
+  }
+  mapping =
+      mmap(nullptr, kRegionSize, PROT_READ, MAP_SHARED, reopened.get(), 0);
+  ASSERT_NE(MAP_FAILED, mapping);
+  EXPECT_EQ(-1, mprotect(mapping, kRegionSize, PROT_READ | PROT_WRITE));
+  munmap(mapping, kRegionSize);
+  EXPECT_EQ(0x5a, reader.GetMemoryAsSpan<const uint8_t>()[0]);
+}
