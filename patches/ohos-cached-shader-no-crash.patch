+// A log that tells one shader failing over and over -- a cache fed by two
+// contexts that disagree, say -- from many shaders failing once each. A
+// shader's text, which runs to kilobytes, is logged the first time only.
+void LogOhosShaderCompileError(const void* context,
+                               const char* shader,
+                               const char* errors,
+                               bool was_cached) {
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::map<uint32_t, int>> failures;
+  static int total = 0;
+  const uint32_t hash = base::PersistentHash(std::string_view(shader));
+  int repeat = 0;
+  int number = 0;
+  {
+    base::AutoLock auto_lock(*lock);
+    repeat = ++(*failures)[hash];
+    number = ++total;
+  }
+  if (repeat == 1) {
+    LOG(ERROR) << "OHOS shader compile error #" << number << " shader=" << hash
+               << " cached=" << was_cached << " context=" << context
+               << " (first for this shader)\n"
+               << shader << "\nErrors:\n"
+               << errors;
+    return;
+  }
+  const std::string_view all_errors(errors);
+  LOG(ERROR) << "OHOS shader compile error #" << number << " shader=" << hash
+             << " cached=" << was_cached << " context=" << context
+             << " repeat=" << repeat << ": "
+             << all_errors.substr(0, all_errors.find('\n'));
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_OHOS)
+
 void SharedContextState::compileError(const char* shader,
                                       const char* errors,
                                       bool shaderWasCached) {
   if (!context_lost()) {
+#if BUILDFLAG(IS_OHOS)
+    LogOhosShaderCompileError(this, shader, errors, shaderWasCached);
+#else
     LOG(ERROR) << "Skia shader compilation error (was cached = "
                << shaderWasCached << ")" << "\n"
                << "------------------------\n"
                << shader << "\nErrors:\n"
                << errors;
+#endif
 
     static crash_reporter::CrashKeyString<8192> shader_key("skia-error-shader");
     shader_key.Set(shader);
@@ -244,6 +293,24 @@ void SharedContextState::compileError(const char* shader,
     error_key.Set(errors);
 
     if (shaderWasCached && use_shader_cache_shm_count_ != nullptr) {
+#if BUILDFLAG(IS_OHOS)
+      // Crashing the GPU process so the browser clears the cache when it
+      // starts another assumes a GPU process of its own. On HarmonyOS the GPU
+      // runs in the browser process: this took down the whole browser (a
+      // cached rounded-rect shader failed to compile on a tablet emulator,
+      // once, after IME input). Drop the cache here instead; Skia skips the
+      // draw it could not make a program for and builds it from source next
+      // time.
+      if (gr_shader_cache_) {
+        // How full it was says whether it refilled since the last failure:
+        // the same shader failing again from a refilled cache points at the
+        // cache, failing again uncached at the driver.
+        LOG(ERROR) << "OHOS shader cache cleared after a cached shader failed: "
+                   << gr_shader_cache_->Clear() << " entries, context="
+                   << this;
+      }
+      return;
+#else
       // https://crbug.com/1442633 Sometimes we would fail to compile a cached
       // GLSL shader because of GL driver change. Increase shader cache shm
       // count and crash the GPU process so that the browser process would clear
@@ -252,6 +319,7 @@ void SharedContextState::compileError(const char* shader,
           use_shader_cache_shm_count_.get());
 
       base::ImmediateCrash();
+#endif
     } else {
       base::debug::DumpWithoutCrashing();
     }
