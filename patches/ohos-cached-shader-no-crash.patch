@@ -169,6 +170,16 @@ void GrShaderCache::PopulateCache(const std::string& key,
 
   CacheData cache_data(MakeData(data));
   auto it = AddToCache(cache_key, std::move(cache_data));
+#if BUILDFLAG(IS_OHOS)
+  // Whether a shader that failed comes back from disk after the memory
+  // cache was cleared: entries are loaded here, at startup and as clients
+  // appear.
+  static int loaded_from_disk = 0;
+  if (++loaded_from_disk == 1 || loaded_from_disk % 100 == 0) {
+    LOG(WARNING) << "OHOS shader cache: " << loaded_from_disk
+                 << " entries loaded from disk";
+  }
+#endif
 
   // This was loaded off the disk cache, no need to push this back for disk
   // write.
@@ -191,6 +202,15 @@ void GrShaderCache::EraseFromCache(Iterator it) {
   store_.Erase(it);
 }
 
+size_t GrShaderCache::Clear() {
+  base::AutoLock auto_lock(lock_);
+  const size_t entries = store_.size();
+  while (!store_.empty()) {
+    EraseFromCache(store_.rbegin());
+  }
+  return entries;
+}
+
 void GrShaderCache::CacheClientIdOnDisk(int32_t client_id) {
   base::AutoLock auto_lock(lock_);
   client_ids_to_cache_on_disk_.insert(client_id);
